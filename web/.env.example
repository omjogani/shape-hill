# Copy to .env.local for local dev. The defaults below already point at a local
# API, so locally this file is optional. On Vercel, set these in
# Project Settings -> Environment Variables.
#
# IMPORTANT: all three are read at BUILD time (two are NEXT_PUBLIC_* baked into
# the client bundle; API_ORIGIN is read when Next builds its routes manifest).
# Changing any of them requires a redeploy to take effect.

# Public origin of the Go API. Next proxies /api/* here (server-side), so the
# browser stays same-origin and there's no CORS. No trailing slash.
API_ORIGIN=http://localhost:8080

# Public origin of the API that serves the embed image (/hill/<slug>.svg).
# Used to build the copy-paste embed markdown. Usually the SAME value as
# API_ORIGIN. No trailing slash.
NEXT_PUBLIC_EMBED_BASE=http://localhost:8080

# Which hill the single-page editor loads and edits. Optional.
NEXT_PUBLIC_HILL_SLUG=demo-billing

NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>