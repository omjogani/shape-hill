# --- local ---
DATABASE_URL="postgres://postgres:postgres@localhost:5432/shapehill?search_path=public&sslmode=disable"

# --- supabase ---
# Only needed for `atlas migrate apply --env supabase`. Leave empty otherwise.
# Supabase → Project Settings → Database → Connection string → URI (Direct connection).
# Must be port 5432 — the 6543 pooler breaks DDL and will fail.
SUPABASE_DATABASE_URL=""


# --- auth ---
# Supabase project URL, e.g. https://<project>.supabase.co (no trailing slash).
# The API verifies access tokens against this project's public JWKS
# (<url>/auth/v1/.well-known/jwks.json). Required. This is the project URL,
# NOT the SUPABASE_DATABASE_URL above.
SUPABASE_URL="https://<project>.supabase.co"
